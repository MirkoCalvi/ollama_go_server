# Backend base URL (no trailing slash). For local Go server use http://localhost:8080.
VITE_API_BASE_URL=http://localhost:8080

# Set to "1" to skip Firebase sign-in entirely. The frontend will skip getIdToken()
# and send requests with no Authorization header. Only useful when the backend
# is running with DEV_MODE=1 (which already ignores the header). Never set to 1
# against a Firebase-backed deployment — every request will get 401.
VITE_DEV_MODE=0

# Firebase Web App config (Firebase console -> Project settings -> Your apps -> Web app -> SDK setup).
# Required when VITE_DEV_MODE=0. Safe to ship to the browser; these are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
